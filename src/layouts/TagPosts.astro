---
import type { CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import ArticleGrid from "@components/ArticleGrid.astro";
import CategoryNav from "@components/CategoryNav.astro";
import Pagination from "@components/Pagination.astro";
import { postCategories } from "@utils/postCategories";
import { SITE } from "@config";

interface Props {
  currentPage: number;
  totalPages: number;
  paginatedPosts: CollectionEntry<"blog">[];
  tag: string;
  tagName: string;
}

const { currentPage, totalPages, paginatedPosts, tag, tagName } = Astro.props;
const category = postCategories.find(item => item.tag === tag);
const tagPath = `/tags/${encodeURIComponent(tag)}`;
---

<Layout title={`${tagName} | ${SITE.title}`}>
  <Header activeNav="tags" />
  <Main
    archive
    pageTitle={["", tagName]}
    titleTransition={tag}
    pageDesc={category?.description ?? `瀏覽標有「${tagName}」的文章。`}
  >
    <CategoryNav active={tag} />
    {
      paginatedPosts.length > 0 ? (
        <ArticleGrid posts={paginatedPosts} />
      ) : (
        <p class="muted-text">這個分類目前沒有已發表的文章。</p>
      )
    }
    <div class="inline-links"><a href="/tags/">查看所有分類與標籤 →</a></div>
  </Main>
  <Pagination
    {currentPage}
    {totalPages}
    prevUrl={`${tagPath}${currentPage > 2 ? "/" + (currentPage - 1) : ""}/`}
    nextUrl={`${tagPath}/${currentPage + 1}/`}
  />
  <Footer noMarginTop={totalPages > 1} />
</Layout>
