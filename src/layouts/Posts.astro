---
import type { CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Pagination from "@components/Pagination.astro";
import ArticleGrid from "@components/ArticleGrid.astro";
import CategoryNav from "@components/CategoryNav.astro";
import { SITE } from "@config";

export interface Props {
  currentPage: number;
  totalPages: number;
  paginatedPosts: CollectionEntry<"blog">[];
}

const { currentPage, totalPages, paginatedPosts } = Astro.props;
---

<Layout title={`文章與觀點 | ${SITE.title}`}>
  <Header activeNav="posts" />
  <Main
    archive
    pageTitle="文章與觀點"
    pageDesc="我對 AI 產業、商業模式與企業經營的觀察。"
  >
    <CategoryNav active="all" />
    {
      paginatedPosts.length > 0 ? (
        <ArticleGrid posts={paginatedPosts} />
      ) : (
        <p class="muted-text">文章準備中。</p>
      )
    }
    <div class="inline-links"><a href="/tags/">查看所有分類與標籤 →</a></div>
  </Main>

  <Pagination
    {currentPage}
    {totalPages}
    prevUrl={`/posts${currentPage - 1 !== 1 ? "/" + (currentPage - 1) : ""}/`}
    nextUrl={`/posts/${currentPage + 1}/`}
  />

  <Footer noMarginTop={totalPages > 1} />
</Layout>
