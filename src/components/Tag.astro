---
interface Props {
  tag: string;
  tagName?: string;
  size?: "sm" | "lg";
}

const { tag, tagName = tag, size = "sm" } = Astro.props;
---

<li class:list={["inline-block", size === "sm" ? "text-sm" : "text-base"]}>
  <a href={`/tags/${encodeURIComponent(tag)}/`} transition:name={tag}
    >#{tagName}</a
  >
</li>

<style>
  a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-inline-end: var(--space-3);
    color: rgb(var(--color-accent));
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
