---
import { SITE } from "@config";

interface Props {
  activeNav?: "posts" | "tags" | "about" | "search";
}

const { activeNav } = Astro.props;
const { pathname } = Astro.url;
const links = [
  { href: "/", name: "首頁", current: pathname === "/" },
  { href: "/about/", name: "關於我", current: activeNav === "about" },
  { href: "/services/", name: "專業服務", current: pathname === "/services/" },
  {
    href: "/posts/",
    name: "文章與觀點",
    current: activeNav === "posts" || activeNav === "tags",
  },
  { href: "/methods/", name: "方法與案例", current: pathname === "/methods/" },
  {
    href: "/contact/",
    name: "聯絡合作",
    current: pathname === "/contact/",
    primary: true,
  },
];
---

<header class="site-header">
  <a class="skip-link" href="#main-content">跳至主要內容</a>
  <div class="site-container header-inner">
    <a href="/" class="wordmark">
      <strong>{SITE.title}</strong>
      <span>米的商業現場</span>
    </a>
    <nav id="site-navigation" aria-label="主導覽">
      <ul>
        {
          links.map(({ href, name, current, primary }) => (
            <li>
              <a
                href={href}
                aria-current={current ? "page" : undefined}
                class:list={[{ "action-link": primary }]}
              >
                {name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="header-tools">
      <a
        href="/search/"
        aria-current={activeNav === "search" ? "page" : undefined}>搜尋</a
      >
      <button
        class="menu-toggle"
        type="button"
        aria-label="選單"
        aria-controls="site-navigation"
        aria-expanded="false"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" class="menu-icon">
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg viewBox="0 0 24 24" aria-hidden="true" class="close-icon">
          <path d="m6 6 12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgb(var(--color-surface-brand));
    border-bottom: 1px solid rgb(var(--color-border));
  }
  .header-inner {
    display: grid;
    grid-template-columns: auto auto;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-3);
  }
  .wordmark {
    display: grid;
    width: fit-content;
    color: rgb(var(--color-brand));
    line-height: 1.25;
    white-space: nowrap;
  }
  .wordmark strong {
    font: 700 1.375rem var(--font-display);
  }
  .wordmark span {
    margin-top: var(--space-1);
    font-size: 0.8125rem;
  }
  nav {
    grid-column: 1 / -1;
    grid-row: 2;
  }
  nav ul,
  .header-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-3);
  }
  nav .action-link {
    color: rgb(var(--color-on-accent));
  }
  .header-tools {
    justify-self: end;
    gap: 0 var(--space-1);
  }
  nav a,
  .header-tools a,
  .header-tools button {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.875rem;
    white-space: nowrap;
  }
  nav a:hover:not(.action-link),
  [aria-current="page"] {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .header-tools button {
    justify-content: center;
    min-width: 44px;
  }
  .header-tools svg {
    width: 1.125rem;
    height: 1.125rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }
  .header-tools .menu-toggle,
  .menu-toggle .close-icon,
  .menu-toggle[aria-expanded="true"] .menu-icon {
    display: none;
  }
  .menu-toggle[aria-expanded="true"] .close-icon {
    display: block;
  }
  .header-tools button:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 2px;
  }
  .skip-link {
    position: absolute;
    left: var(--space-4);
    top: var(--space-3);
    z-index: 5;
    padding: var(--space-2) var(--space-3);
    background: rgb(var(--color-card));
    transform: translateY(-150%);
  }
  .skip-link:focus {
    transform: none;
  }

  @media not all and (min-width: 960px) {
    .header-inner {
      gap: var(--space-1) var(--space-2);
      padding-block: var(--space-2);
    }
    .wordmark strong {
      font-size: 1.25rem;
    }
    .site-header[data-nav-ready] .menu-toggle {
      display: inline-flex;
    }
    .site-header[data-nav-ready] nav {
      display: none;
      position: absolute;
      top: 100%;
      inset-inline: 0;
      max-height: calc(100dvh - var(--site-header-height, 4rem));
      overflow-y: auto;
      padding: var(--space-2) var(--page-gutter) var(--space-3);
      border-bottom: 1px solid rgb(var(--color-border));
      background: rgb(var(--color-surface-brand));
    }
    .site-header[data-menu-open] nav {
      display: block;
    }
    .site-header[data-nav-ready] nav ul {
      display: grid;
    }
    .site-header[data-nav-ready] nav a:not(.action-link) {
      width: 100%;
    }
  }

  @media (min-width: 960px) {
    .header-inner {
      grid-template-columns: auto 1fr auto;
    }
    nav {
      grid-column: auto;
      grid-row: auto;
    }
    nav ul {
      justify-content: end;
      gap: 0 var(--space-4);
    }
  }
</style>

<script>
  const headerSize = new ResizeObserver(([entry]) => {
    updateHeaderHeight(entry.target);
  });

  function updateHeaderHeight(header: Element) {
    document.documentElement.style.setProperty(
      "--site-header-height",
      `${header.getBoundingClientRect().height}px`
    );
  }

  function connectHeader() {
    headerSize.disconnect();
    const header = document.querySelector<HTMLElement>(".site-header");
    const toggle = header?.querySelector<HTMLButtonElement>(".menu-toggle");
    const nav = header?.querySelector("nav");
    if (!header || !toggle || !nav) return;

    function setMenu(open: boolean) {
      header?.toggleAttribute("data-menu-open", open);
      toggle?.setAttribute("aria-expanded", String(open));
    }

    header.setAttribute("data-nav-ready", "");
    updateHeaderHeight(header);
    headerSize.observe(header);

    toggle.addEventListener("click", () => {
      const open = toggle.getAttribute("aria-expanded") !== "true";
      setMenu(open);
      if (open) nav.querySelector("a")?.focus();
    });
    header.addEventListener("focusout", event => {
      if (
        !(event.relatedTarget instanceof Node) ||
        !header.contains(event.relatedTarget)
      ) {
        setMenu(false);
      }
    });
    nav.addEventListener("click", event => {
      if (event.target instanceof Element && event.target.closest("a")) {
        setMenu(false);
      }
    });
    header.addEventListener("keydown", event => {
      if (
        event.key === "Escape" &&
        toggle.getAttribute("aria-expanded") === "true"
      ) {
        setMenu(false);
        toggle.focus();
      }
    });
  }

  connectHeader();
  document.addEventListener("astro:after-swap", connectHeader);
</script>
