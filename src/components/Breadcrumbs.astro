---
interface Props {
  wide?: boolean;
}

const { wide = false } = Astro.props;
const parts = Astro.url.pathname.split("/").filter(Boolean);
const [section, tagOrPage, tagPage] = parts;
const labels: Record<string, string> = {
  posts: "文章與觀點",
  tags: "文章分類",
  about: "關於我",
  search: "搜尋",
  services: "專業服務",
  methods: "方法與案例",
  contact: "聯絡合作",
};

const breadcrumbs = [
  {
    name: labels[section] ?? decodeURIComponent(section ?? ""),
    href: `/${section}/`,
  },
];

if (section === "posts" && tagOrPage) {
  breadcrumbs.push({ name: `第 ${tagOrPage} 頁`, href: Astro.url.pathname });
}
if (section === "tags" && tagOrPage) {
  breadcrumbs.push({
    name: decodeURIComponent(tagOrPage),
    href: `/tags/${tagOrPage}/`,
  });
  if (tagPage && tagPage !== "1") {
    breadcrumbs.push({ name: `第 ${tagPage} 頁`, href: Astro.url.pathname });
  }
}
---

<nav
  class:list={[
    wide ? "site-container" : "reading-container",
    "breadcrumb",
    "muted-text",
  ]}
  aria-label="目前位置"
>
  <ol>
    <li><a href="/">首頁</a></li>
    {
      breadcrumbs.map(({ name, href }, index) => (
        <li>
          <span aria-hidden="true">›</span>
          {index === breadcrumbs.length - 1 ? (
            <span aria-current="page">{name}</span>
          ) : (
            <a href={href}>{name}</a>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .breadcrumb {
    padding-top: var(--space-6);
    font-size: 0.875rem;
  }
  ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  li {
    display: inline-flex;
    gap: var(--space-2);
  }
  a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
