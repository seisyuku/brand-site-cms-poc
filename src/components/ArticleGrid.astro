---
import type { CollectionEntry } from "astro:content";
import Datetime from "@components/Datetime";
import { getPostCategory } from "@utils/postCategories";
import { slugifyStr } from "@utils/slugify";

interface Props {
  posts: CollectionEntry<"blog">[];
}

const { posts } = Astro.props;

function coverSource(image: CollectionEntry<"blog">["data"]["ogImage"]) {
  const source = typeof image === "string" ? image : image?.src;
  if (!source) return;

  const url = new URL(source, Astro.url.origin);
  return url.origin === Astro.url.origin
    ? url.pathname + url.search + url.hash
    : url.href;
}
---

<ul class="article-grid">
  {
    posts.map(({ data, slug }) => {
      const {
        title,
        description,
        pubDatetime,
        modDatetime,
        tags,
        ogImage,
        featured,
      } = data;
      const category = getPostCategory(tags);
      const cover = coverSource(ogImage);

      return (
        <li class="article-card">
          {cover && (
            <div class="article-cover">
              <img src={cover} alt="" loading="lazy" decoding="async" />
            </div>
          )}
          {featured && <span class="featured-label">精選</span>}
          <h2 class="article-title" transition:name={slugifyStr(title)}>
            <a href={`/posts/${slug}/`}>{title}</a>
          </h2>
          <p class="article-summary muted-text">{description}</p>
          <div class="article-meta">
            {category && (
              <a
                class="article-category"
                href={`/tags/${encodeURIComponent(category.tag)}/`}
              >
                {category.name}
              </a>
            )}
            <Datetime {pubDatetime} {modDatetime} />
          </div>
        </li>
      );
    })
  }
</ul>

<style>
  .article-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8) var(--space-6);
    margin-block: var(--space-6);
  }
  .article-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    border-top: 1px solid rgb(var(--color-border));
    padding-block: var(--space-4);
  }
  .article-cover {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-media);
    background: rgb(var(--color-surface-brand));
  }
  .article-cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .featured-label {
    align-self: flex-start;
    margin-top: var(--space-2);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-control);
    background: rgb(var(--color-surface-brand));
    color: rgb(var(--color-brand));
    font-size: 0.875rem;
  }
  .article-title {
    margin-top: var(--space-3);
    font-size: var(--type-card-title);
  }
  .article-title a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius-media);
  }
  .article-title a:focus-visible::after {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 4px;
  }
  .article-title a:focus-visible {
    outline: none;
  }
  .article-card:hover .article-title a {
    color: rgb(var(--color-accent));
  }
  .article-summary {
    margin-block: var(--space-2) var(--space-3);
  }
  .article-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0 var(--space-3);
    margin-top: auto;
    font-size: 0.875rem;
  }
  .article-category {
    position: relative;
    color: rgb(var(--color-accent));
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  @media (min-width: 768px) {
    .article-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
